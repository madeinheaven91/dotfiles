configuration {
	display-drun: "";
	display-clipboard: "";
	drun-display-format: "{name}";
	modi: "drun";
}

* {
    font:   "FiraCode Nerd Font Medium 36";

    bg0: #1a1b26;
    bg1: #444b6a;
    fg0: #a9b1d6;

    accent-color:     #ff7a93;
    urgent-color:     #ff9e64 ;

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    location:   center;
    width:      480;
    anchor: north;
    border: 5px;
    padding: 5;
    border-radius: 15px;
    border-color: @accent-color;
    background-color:   @bg0;
}

mainbox {
	background-color: @bg;
	children: [listview];
	padding: 0;
}

listview {
    lines:      8;
    columns:    1;

    fixed-height:   false;
}

element {
    padding:    8px;
    spacing:    8px;
    border-radius:  10px;
}

element normal normal {
    text-color: @fg0;
}

element normal urgent {
    text-color: @urgent-color;
}

element normal active {
    text-color: @accent-color;
}

element alternate active {
    text-color: @accent-color;
}

element selected {
    text-color: @bg0;
}

element selected normal, element selected active {
    background-color:   @accent-color;
}

element selected urgent {
    background-color:   @urgent-color;
}

element-icon {
    size:   0.8em;
}

element-text {
    text-color: inherit;
}
